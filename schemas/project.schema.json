{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paperkeel/infisical-iac/schemas/project.schema.json",
  "title": "Infisical IaC project configuration",
  "description": "Declares one Infisical project: environments, secret sets (folders), secret objects, and Secret Syncs. Never contains secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "environments", "secret_sets"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "slug": { "$ref": "#/$defs/slug" },
        "description": { "type": "string", "maxLength": 256 },
        "delete_protection": { "type": "boolean", "default": true },
        "audit_log_retention_days": { "type": "integer", "minimum": 0 }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "position"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "position": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "secret_sets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "secrets"],
        "properties": {
          "path": { "$ref": "#/$defs/folderPath" },
          "description": { "type": "string", "maxLength": 256 },
          "secrets": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/secretName" },
            "additionalProperties": { "$ref": "#/$defs/secret" }
          }
        }
      }
    },
    "identities": {
      "description": "Project-scoped machine identities (e.g. an application's runtime identity) and their project role.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role"],
        "properties": {
          "description": { "type": "string", "maxLength": 256 },
          "role": { "type": "string", "enum": ["viewer", "member", "admin", "no-access"] },
          "oidc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issuer", "discovery_url"],
            "properties": {
              "issuer": { "type": "string", "format": "uri" },
              "discovery_url": { "type": "string", "format": "uri" },
              "bound_audiences": { "type": "array", "items": { "type": "string" } },
              "bound_subject": { "type": "string" },
              "bound_claims": { "type": "object", "additionalProperties": { "type": "string" } },
              "access_token_ttl": { "type": "integer", "minimum": 60 }
            }
          }
        }
      }
    },
    "syncs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "source", "connection", "destination"],
        "properties": {
          "type": { "type": "string", "enum": ["github", "cloudflare-workers", "railway"] },
          "description": { "type": "string", "maxLength": 256 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environment", "secret_set"],
            "properties": {
              "environment": { "$ref": "#/$defs/slug" },
              "secret_set": { "$ref": "#/$defs/slug" }
            }
          },
          "connection": { "type": "string", "enum": ["github", "cloudflare", "railway"] },
          "destination": { "type": "object" },
          "auto_sync": { "type": "boolean", "default": true },
          "manage_deletions": {
            "description": "When true (default) Infisical owns the destination and removes keys it no longer sources. Set false only during a documented migration window.",
            "type": "boolean",
            "default": true
          },
          "initial_sync_behavior": {
            "type": "string",
            "enum": [
              "overwrite-destination",
              "import-prioritize-source",
              "import-prioritize-destination"
            ],
            "default": "overwrite-destination"
          },
          "key_schema": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "github" } } },
            "then": {
              "properties": {
                "connection": { "const": "github" },
                "destination": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scope", "owner"],
                  "properties": {
                    "scope": { "enum": ["repository", "repository-environment", "organization"] },
                    "owner": { "type": "string", "minLength": 1 },
                    "repository": { "type": "string", "minLength": 1 },
                    "repository_environment": { "type": "string", "minLength": 1 },
                    "visibility": { "enum": ["all", "private", "selected"] },
                    "selected_repository_ids": { "type": "array", "items": { "type": "integer" } }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "cloudflare-workers" } } },
            "then": {
              "properties": {
                "connection": { "const": "cloudflare" },
                "destination": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["script_id"],
                  "properties": { "script_id": { "type": "string", "minLength": 1 } }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "railway" } } },
            "then": {
              "properties": {
                "connection": { "const": "railway" },
                "destination": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["project_id", "environment_id"],
                  "properties": {
                    "project_id": { "type": "string", "minLength": 1 },
                    "project_name": { "type": "string" },
                    "environment_id": { "type": "string", "minLength": 1 },
                    "environment_name": { "type": "string" },
                    "service_id": { "type": "string" },
                    "service_name": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Lowercase, digits, and hyphens. Stable: renaming recreates resources."
    },
    "folderPath": {
      "type": "string",
      "pattern": "^/[a-z0-9][a-z0-9-]*$",
      "description": "Absolute single-level folder path, e.g. /runtime. Root (/) is not allowed (every secret set is a dedicated delivery boundary) and nesting is not supported in schema v1."
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "SCREAMING_SNAKE_CASE."
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_in"],
      "properties": {
        "required_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" },
          "description": "Environments in which this secret object must exist. Must reference declared environments."
        },
        "comment": { "type": "string", "maxLength": 512 },
        "reminder_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "placeholder_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "DESTRUCTIVE when incremented: Terraform rewrites the live value with the placeholder. Never change for rotation."
        }
      }
    }
  }
}
